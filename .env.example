# ──────────────────────────────────────────────────────────────────────────────
# AI Study Coach — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Add your key from https://openrouter.ai/keys
# 3. Restart dev server: npm run dev
#
# Without these the app runs in Demo Mode (Algebra / Photosynthesis / Gravity).
# With them, ANY topic works!
# ──────────────────────────────────────────────────────────────────────────────

# Tells the browser that AI is available (safe to expose — not a secret)
VITE_AI_ENABLED=true

# Your OpenRouter API key — server-side only, NEVER exposed to the browser
OPENROUTER_API_KEY=sk-or-v1-...your-key-here
